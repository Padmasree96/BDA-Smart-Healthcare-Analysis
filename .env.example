# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=patient-vitals
ALERTS_TOPIC=patient-alerts

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=SmartHealthcareAnalytics

# Data Directories
DATA_RAW_DIR=data/raw
DATA_MODELS_DIR=data/models
DATA_PROCESSED_DIR=data/processed
DATA_ALERTS_DIR=data/alerts

# Streamlit Configuration
STREAMLIT_PORT=8501
